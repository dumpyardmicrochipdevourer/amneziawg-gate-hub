# Managed by amneziawg-cascade. Clients are managed in inventory.
[Interface]
{% if item == awg_client_interface and awg_node_role == 'gate' %}
PrivateKey = {{ awg_private_keys['entry'] }}
Address = {{ awg_client_subnet }}.1/24
ListenPort = {{ awg_client_port }}
{% set obfuscation = awg_entry_obfuscation %}
{% else %}
PrivateKey = {{ awg_private_keys['link'] }}
Address = {{ awg_link_subnet }}.{{ '2' if awg_node_role == 'gate' else '1' }}/30
ListenPort = {{ awg_gate_link_port if awg_node_role == 'gate' else awg_hub_port }}
Table = off
{% set obfuscation = awg_link_obfuscation %}
{% endif %}
MTU = {{ awg_mtu }}
{% for key, value in obfuscation.items() %}
{{ key }} = {{ value }}
{% endfor %}
PostUp = /usr/local/sbin/awg-cascade-{{ item }} up
PostDown = /usr/local/sbin/awg-cascade-{{ item }} down

{% if item == awg_client_interface and awg_node_role == 'gate' %}
{% set dynamic = awg_dynamic_clients | default([]) %}
{% set removed = awg_removed_clients | default([]) %}
{% set dynamic_names = dynamic | map(attribute='name') | list %}
{% for client in awg_clients if client.name not in removed and client.name not in dynamic_names %}
[Peer]
# {{ client.name }}
PublicKey = {{ awg_public_keys['client-' + client.name] }}
AllowedIPs = {{ awg_client_subnet }}.{{ client.octet }}/32

{% endfor %}
{% for client in dynamic %}
[Peer]
# {{ client.name }}
PublicKey = {{ client.public_key }}
AllowedIPs = {{ awg_client_subnet }}.{{ client.octet }}/32

{% endfor %}
{% else %}
[Peer]
PublicKey = {{ awg_hub_link_public_key if awg_node_role == 'gate' else awg_gate_link_public_key }}
{% if awg_node_role == 'gate' %}
Endpoint = {{ hostvars[awg_hub].ansible_host }}:{{ awg_hub_port }}
AllowedIPs = 0.0.0.0/0
{% else %}
AllowedIPs = {{ awg_link_subnet }}.2/32
{% endif %}
PersistentKeepalive = 25
{% endif %}
